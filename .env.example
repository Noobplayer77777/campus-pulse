# ==============================================================================
# Campus Pulse - Frontend Environment Configuration Template
# ==============================================================================
# Note: All REACT_APP_* variables are embedded as plain text constants in the 
# browser client build bundle (build/static/js/*.js). NEVER place confidential 
# secrets, private keys, database passwords, or privileged credentials here.
# ==============================================================================

# Backend API Gateway HTTP API endpoint (provided by SAM template output: ApiUrl)
REACT_APP_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com

# Target AWS Deployment Region
REACT_APP_AWS_REGION=us-east-1

# Amazon Cognito User Pool ID (provided by SAM template output: UserPoolId)
REACT_APP_COGNITO_USER_POOL_ID=us-east-1_examplePoolId

# Amazon Cognito Public App Client ID (provided by SAM template output: UserPoolClientId)
# Note: Public SPA clients must NOT have a Client Secret!
# Either REACT_APP_COGNITO_APP_CLIENT_ID or REACT_APP_COGNITO_CLIENT_ID is supported.
REACT_APP_COGNITO_APP_CLIENT_ID=exampleAppClientId123456789

# Authentication Provider: 'cognito' (AWS production), 'mock' (local dev only), 'firebase' (legacy rollback)
REACT_APP_AUTH_PROVIDER=cognito

# Data Provider: 'aws' (DynamoDB & API Gateway), 'firebase' (legacy Firestore rollback)
REACT_APP_DATA_PROVIDER=aws

# AI & Chatbot Configuration
# SECURITY WARNING: Any key in REACT_APP_* is compiled into client JavaScript and publicly visible.
# Leave blank to use the built-in offline mock assistant (safe for college assignments/demos).
# For production AI with live models, route requests through a backend Lambda proxy rather than exposing keys.
REACT_APP_GEMINI_KEY=
REACT_APP_AI_PROVIDER=mock
